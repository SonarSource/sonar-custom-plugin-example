{
  "name": "sonar-custom-plugin-example",
  "license": "LGPL-3.0",
  "version": "7.0.0",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-flow": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "autoprefixer": "10.6.1",
    "babel-jest": "30.5.2",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.5",
    "dotenv": "18.0.8",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "postcss": "8.5.30",
    "postcss-loader": "8.2.1",
    "react": "15.6.2",
    "react-dom": "15.6.2",
    "style-loader": "4.0.0",
    "webpack": "5.112.0",
    "webpack-dev-server": "6.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/start.js",
    "test": "node scripts/test.js",
    "verify:dev": "node --test tests/dev-server.test.cjs"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ],
      [
        "@babel/preset-react",
        {
          "runtime": "classic"
        }
      ],
      "@babel/preset-flow"
    ]
  },
  "jest": {
    "coverageDirectory": "<rootDir>/target/coverage",
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules",
      "<rootDir>/tests"
    ],
    "moduleFileExtensions": [
      "jsx",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^.+\\.(hbs|jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/conf/jest/FileStub.js",
      "^.+\\.css$": "<rootDir>/conf/jest/CSSStub.js"
    },
    "setupFiles": [
      "<rootDir>/conf/jest/SetupTestEnvironment.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules",
      "<rootDir>/scripts",
      "<rootDir>/conf"
    ],
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "backbone": "^1.4.0",
    "jquery": "^1.11.0",
    "underscore": "^1.9.1"
  },
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "browserslist": [
    "last 3 Chrome versions",
    "last 3 Firefox versions",
    "last 3 Safari versions",
    "last 3 Edge versions",
    "IE 11"
  ]
}
