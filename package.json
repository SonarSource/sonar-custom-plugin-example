{
  "name": "sonar-custom-plugin-example",
  "license": "LGPL-3.0",
  "version": "7.0.0",
  "devDependencies": {
    "autoprefixer": "10.6.1",
    "babel-core": "6.14.0",
    "babel-jest": "30.5.2",
    "babel-loader": "10.1.1",
    "babel-preset-react-app": "10.1.0",
    "cross-env": "10.1.0",
    "cross-spawn": "7.0.6",
    "css-loader": "7.1.5",
    "detect-port": "2.1.0",
    "dotenv": "18.0.9",
    "enzyme": "3.11.0",
    "enzyme-to-json": "3.6.2",
    "expose-loader": "5.0.1",
    "express": "5.3.0",
    "express-http-proxy": "2.1.2",
    "filesize": "11.0.29",
    "find-cache-dir": "6.0.0",
    "gzip-size": "7.0.0",
    "imports-loader": "5.0.0",
    "jest": "30.5.2",
    "json-loader": "0.5.4",
    "path-exists": "5.0.0",
    "postcss-loader": "8.2.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-addons-shallow-compare": "15.6.2",
    "react-addons-test-utils": "15.6.2",
    "react-dev-utils": "12.0.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "react-transform-hmr": "1.0.4",
    "recursive-readdir": "2.1.0",
    "rimraf": "6.1.3",
    "script-loader": "0.6.1",
    "strip-ansi": "7.2.0",
    "style-loader": "4.0.0",
    "webpack": "5.112.2",
    "webpack-dev-server": "6.1.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/start.js",
    "test": "node scripts/test.js"
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "jest": {
    "coverageDirectory": "<rootDir>/target/coverage",
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules",
      "<rootDir>/tests"
    ],
    "moduleFileExtensions": [
      "jsx",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^.+\\.(hbs|jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/conf/jest/FileStub.js",
      "^.+\\.css$": "<rootDir>/conf/jest/CSSStub.js"
    },
    "setupFiles": [
      "<rootDir>/conf/jest/SetupTestEnvironment.js"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules",
      "<rootDir>/scripts",
      "<rootDir>/conf"
    ]
  },
  "dependencies": {
    "backbone": "^1.4.0",
    "jquery": "^4.0.0",
    "underscore": "^1.9.1"
  },
  "packageManager": "yarn@4.5.0"
}
